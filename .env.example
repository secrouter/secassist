# SecAssist (.env) — copy to .env and fill in. NEVER commit .env.
# Generate each secret with the openssl command in its comment.

# ── Site URLs ──────────────────────────────────────────────────────────────────────
# The externally-reachable URL of this UI (behind SecProxy/TLS in production).
DOMAIN_CLIENT=https://secassist.sec.internal
DOMAIN_SERVER=https://secassist.sec.internal
SECASSIST_HTTP_PORT=3080

# ── LibreChat secrets (required) ────────────────────────────────────────────────────
#   openssl rand -hex 32   → CREDS_KEY, JWT_SECRET, JWT_REFRESH_SECRET, OPENID_SESSION_SECRET
#   openssl rand -hex 16   → CREDS_IV, MEILI_MASTER_KEY
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=

# ── Login: SSO only (no local accounts) ─────────────────────────────────────────────
# Registration and email/password login are OFF; users authenticate through SecSSO.
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true

# ── SSO via SecSSO (OpenID Connect) ─────────────────────────────────────────────────
# Matches blueprints/secassist.yaml in the secsso repo (confidential client "secassist").
OPENID_ISSUER=https://secsso.sec.internal/application/o/secassist/
OPENID_CLIENT_ID=secassist
OPENID_CLIENT_SECRET=
OPENID_SESSION_SECRET=
OPENID_SCOPE=openid profile email groups
OPENID_CALLBACK_URL=/oauth/callback/openid
OPENID_EMAIL_CLAIM=email
OPENID_NAME_CLAIM=name
OPENID_USERNAME_CLAIM=preferred_username
OPENID_BUTTON_LABEL=Sign in with SecSSO
# Skip LibreChat's own landing page and go straight to SecSSO:
OPENID_AUTO_REDIRECT=true

# ── Governed inference via SecRouter (used by the auth proxy) ────────────────────────
# The proxy authenticates to SecRouter as the svc-secassist service account and forwards
# each signed-in user, so the gateway governs per end-user. See docs/governance.md.
SECROUTER_BASE_URL=https://secrouter.sec.internal:47002
SECSSO_TOKEN_URL=https://secsso.sec.internal/application/o/token/
SECASSIST_SVC_CLIENT_ID=secassist-svc
SECASSIST_SVC_CLIENT_SECRET=
# The "secrouter" scope injects SecRouter's audience into the token (same as SecAgent).
SECROUTER_SCOPE=openid secrouter

# ── Internal TLS trust (SecCert CA) ─────────────────────────────────────────────────
# These are optional config, not secrets — left commented so a deploy's auto-secret step
# (which fills every blank KEY=) doesn't put a random token in them. Uncomment as needed:
#   Production: mount the suite CA and point NODE_EXTRA_CA_CERTS at it (compose override).
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/suite-ca.pem
#   Eval with self-signed certs ONLY (never in production):
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Pinned image versions ───────────────────────────────────────────────────────────
LIBRECHAT_VERSION=v0.8.7
MONGO_VERSION=7.0.14
MEILI_VERSION=v1.12.3
SECASSIST_PROXY_VERSION=0.1.0
